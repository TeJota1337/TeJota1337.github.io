---
import ViewerItem from "../components/ViewerItem.astro";
import SocialRail from "../components/SocialRail.astro";
import { projects } from "../data/projects";
import { certificates } from "../data/certificates";
import "../styles/global.css";

const education = projects.filter((p) => p.category === "education");
const gamejams = projects.filter((p) => p.category === "gamejam");
---

<html lang="pt" data-lang="pt">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Tiago "TJ" Jonathan — Game &amp; UX Designer</title>
    <meta
      name="description"
      content="IxD/UX Game Designer portfolio — VR experiences, serious games and game jam projects."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barriecito&family=Rajdhani:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>

    <SocialRail />

    <div id="app">
      <!-- SCREEN: splash -->
      <section class="screen active" data-screen="splash">
        <div class="splash-inner">
          <button type="button" class="logo-mark big" id="splash-logo" aria-label="Enter">TJ</button>
          <p class="splash-tag">
            <span class="lang-pt">IxD/UI/UX Game Designer</span>
            <span class="lang-en">IxD/UI/UX Game Designer</span>
          </p>
          <p class="splash-bio">
            <span class="lang-pt">
              Formado em Jogos Digitais e gamer desde sempre. Crio experiências centradas no
              jogador, com foco em usabilidade e imersão. Atualmente integro a equipe do Centro de
              Realidade Estendida da PUCPR.
            </span>
            <span class="lang-en">
              Graduated in Digital Games, gamer forever. I create player-centered experiences
              focused on usability and immersion. Currently part of PUCPR's Extended Reality
              Center team.
            </span>
          </p>
          <p class="splash-hint">
            <span class="lang-pt">Clique para entrar</span>
            <span class="lang-en">Click to enter</span>
          </p>
        </div>
      </section>

      <!-- SCREEN: menu -->
      <section class="screen" data-screen="menu">
        <header class="app-header">
          <span class="logo-mark">TJ</span>
          <div class="lang-toggle" role="group" aria-label="Language">
            <button type="button" data-lang-btn="pt" aria-pressed="true">PT</button>
            <button type="button" data-lang-btn="en" aria-pressed="false">EN</button>
          </div>
        </header>
        <nav class="menu-list" aria-label="Main menu">
          <button type="button" class="menu-item glitch-target" data-target="education">
            <span class="lang-pt">Projetos</span><span class="lang-en">Projects</span>
          </button>
          <button type="button" class="menu-item glitch-target" data-target="gamejam">
            <span class="lang-pt">Jogos de Jam</span><span class="lang-en">Game Jams</span>
          </button>
          <button type="button" class="menu-item glitch-target" data-target="certificates">
            <span class="lang-pt">Certificados</span><span class="lang-en">Certificates</span>
          </button>
        </nav>
        <div class="menu-dots" aria-hidden="true">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        </div>
      </section>

      <!-- SCREEN: project / game jam viewer -->
      <section class="screen" data-screen="viewer">
        <header class="app-header">
          <span class="logo-mark">TJ</span>
          <div class="lang-toggle" role="group" aria-label="Language">
            <button type="button" data-lang-btn="pt" aria-pressed="true">PT</button>
            <button type="button" data-lang-btn="en" aria-pressed="false">EN</button>
          </div>
        </header>
        <h2 class="viewer-title glitch-target" id="viewer-title">Projetos</h2>
        <div class="viewer-stage">
          <button type="button" class="arrow up" id="viewer-prev" aria-label="Previous">▲</button>
          <div class="viewer-track">
            {education.map((project, i) => (
              <ViewerItem project={project} index={i} category="education" />
            ))}
            {gamejams.map((project, i) => (
              <ViewerItem project={project} index={i} category="gamejam" />
            ))}
          </div>
          <button type="button" class="arrow down" id="viewer-next" aria-label="Next">▼</button>
          <button type="button" class="btn-back glitch-target" id="viewer-back">
            <span class="lang-pt">Voltar</span><span class="lang-en">Back</span>
          </button>
        </div>
      </section>

      <!-- SCREEN: certificates coverflow -->
      <section class="screen" data-screen="certs">
        <header class="app-header">
          <span class="logo-mark">TJ</span>
          <div class="lang-toggle" role="group" aria-label="Language">
            <button type="button" data-lang-btn="pt" aria-pressed="true">PT</button>
            <button type="button" data-lang-btn="en" aria-pressed="false">EN</button>
          </div>
        </header>
        <h2 class="viewer-title glitch-target">
          <span class="lang-pt">Certificados</span><span class="lang-en">Certificates</span>
        </h2>
        <div class="cert-stage">
          <div class="cert-track">
            {certificates.map((cert) => (
              <a class="cert-slide" href={cert.verifyUrl || cert.image} target="_blank" rel="noopener noreferrer">
                <div class="cert-thumb">
                  <img src={cert.image} alt={cert.title} loading="lazy" />
                </div>
                <h3>{cert.title}</h3>
                <p class="meta">{cert.issuer} · {cert.date}</p>
              </a>
            ))}
          </div>
          <div class="cert-dots" id="cert-dots"></div>
          <button type="button" class="btn-back glitch-target" id="certs-back">
            <span class="lang-pt">Voltar</span><span class="lang-en">Back</span>
          </button>
        </div>
      </section>
    </div>

    <script>
      import { initScreens, initHoverGlitch } from "../scripts/screens";

      initScreens();
      initHoverGlitch();

      // Language toggle
      const langButtons = document.querySelectorAll<HTMLButtonElement>("[data-lang-btn]");
      langButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const lang = btn.dataset.langBtn as "pt" | "en";
          document.documentElement.dataset.lang = lang;
          document.documentElement.lang = lang;
          langButtons.forEach((b) =>
            b.setAttribute("aria-pressed", String(b === btn))
          );
        });
      });
    </script>
  </body>
</html>
