---
import ProjectCarousel from "../components/ProjectCarousel.astro";
import SocialRail from "../components/SocialRail.astro";
import CertificatesSection from "../components/CertificatesSection.astro";
import { projects } from "../data/projects";
import "../styles/global.css";

const education = projects.filter((p) => p.category === "education");
const gamejams = projects.filter((p) => p.category === "gamejam");
---

<html lang="pt" data-lang="pt">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Tiago "TJ" Jonathan — Game &amp; UX Designer</title>
    <meta
      name="description"
      content="IxD/UX Game Designer portfolio — VR experiences, serious games and game jam projects."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>

    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
      <defs>
        <symbol id="f-tri" viewBox="0 0 100 100">
          <path d="M50 15 L85 80 H15 Z" fill="none" stroke="currentColor" stroke-width="6" stroke-linejoin="round"></path>
        </symbol>
        <symbol id="f-target" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="32" fill="none" stroke="currentColor" stroke-width="6"></circle>
          <path d="M18 50H82" stroke="currentColor" stroke-width="6"></path>
        </symbol>
        <symbol id="f-bars" viewBox="0 0 100 100">
          <g fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round">
            <path d="M20 30H80M20 50H80M20 70H80"></path>
          </g>
          <circle cx="34" cy="30" r="6" fill="currentColor"></circle>
          <circle cx="62" cy="50" r="6" fill="currentColor"></circle>
          <circle cx="44" cy="70" r="6" fill="currentColor"></circle>
        </symbol>
        <symbol id="f-dash" viewBox="0 0 100 100">
          <rect x="10" y="35" width="80" height="30" rx="10" fill="none" stroke="currentColor" stroke-width="6"></rect>
        </symbol>
      </defs>
    </svg>

    <header class="site-header">
      <span class="logo-mark">[<span class="accent">TJ</span>]</span>
      <div class="lang-toggle" role="group" aria-label="Language">
        <button type="button" data-lang-btn="pt" aria-pressed="true">PT</button>
        <button type="button" data-lang-btn="en" aria-pressed="false">EN</button>
      </div>
    </header>

    <SocialRail />

    <main>
      <section class="hero container">
        <div class="floaters" aria-hidden="true">
          <div class="floater" data-depth="0.9" style="left: 8%; top: 20%; width: 64px; height: 64px;">
            <svg style="--d: 5.5s; --r1: -6deg; --r2: 4deg"><use href="#f-tri"></use></svg>
          </div>
          <div class="floater" data-depth="0.5" style="left: 85%; top: 16%; width: 56px; height: 56px;">
            <svg style="--d: 7s; --r1: -7deg; --r2: 5deg"><use href="#f-target"></use></svg>
          </div>
          <div class="floater" data-depth="1.1" style="left: 88%; top: 72%; width: 60px; height: 60px;">
            <svg style="--d: 6s; --r1: -8deg; --r2: 6deg"><use href="#f-bars"></use></svg>
          </div>
          <div class="floater" data-depth="0.7" style="left: 6%; top: 74%; width: 70px; height: 70px;">
            <svg style="--d: 8s; --r1: -9deg; --r2: 7deg"><use href="#f-dash"></use></svg>
          </div>
        </div>
        <p class="hero-eyebrow">
          <span class="lang-pt">IxD / UX Game Designer</span>
          <span class="lang-en">IxD / UX Game Designer</span>
        </p>
        <h1>
          <span class="lang-pt">Oi, eu sou o <span class="highlight">Tiago "TJ" Jonathan</span>.</span>
          <span class="lang-en">Hi, I'm <span class="highlight">Tiago "TJ" Jonathan</span>.</span>
        </h1>
        <p class="bio lang-pt">
          Formado em Jogos Digitais (2024) e gamer desde sempre. Crio experiências centradas no
          jogador, com foco em usabilidade e imersão. Atualmente integro a equipe do Centro de
          Realidade Estendida da PUCPR, desenvolvendo experiências em realidade virtual.
        </p>
        <p class="bio lang-en">
          I graduated in Digital Games (2024) and have been a gamer forever. I create
          player-centered experiences focused on usability and immersion. I'm currently part of
          PUCPR's Extended Reality Center team, developing virtual reality experiences.
        </p>
        <div class="hero-actions">
          <button type="button" class="btn-primary" id="view-portfolio">
            <span class="lang-pt">Ver Portfólio</span>
            <span class="lang-en">View Portfolio</span>
          </button>
          <a class="hero-contact" href="mailto:tiago.jonathan@pucpr.br">tiago.jonathan@pucpr.br</a>
        </div>
        <div class="hero-scroll-hint">
          <span class="line"></span>
          <span class="lang-pt">Role para baixo</span>
          <span class="lang-en">Scroll down</span>
        </div>
      </section>

      <svg class="wave-divider" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,50 L1000,50 L1000,101 L0,101 Z"></path>
      </svg>

      <div class="ticker">
        <div class="track">
          <span>Game Design</span><span class="dot">·</span><span>Level Design</span><span class="dot">·</span>
          <span>UI/UX</span><span class="dot">·</span><span>IxD</span><span class="dot">·</span>
          <span>VR / XR</span><span class="dot">·</span><span>Unity</span><span class="dot">·</span>
          <span>Prototyping</span><span class="dot">·</span><span>Playtesting</span><span class="dot">·</span>
          <span>Game Design</span><span class="dot">·</span><span>Level Design</span><span class="dot">·</span>
          <span>UI/UX</span><span class="dot">·</span><span>IxD</span><span class="dot">·</span>
          <span>VR / XR</span><span class="dot">·</span><span>Unity</span><span class="dot">·</span>
          <span>Prototyping</span><span class="dot">·</span><span>Playtesting</span><span class="dot">·</span>
        </div>
      </div>

      <section class="section container" id="projects">
        <div class="section-heading">
          <h2>
            <span class="lang-pt">Experiências em VR &amp; Educação</span>
            <span class="lang-en">VR &amp; Education Experiences</span>
          </h2>
          <span class="count">{education.length} projects</span>
        </div>
        <ProjectCarousel items={education} id="carousel-education" />
      </section>

      <section class="section container" id="gamejams">
        <div class="section-heading">
          <h2>
            <span class="lang-pt">Jogos de Game Jam</span>
            <span class="lang-en">Game Jam Games</span>
          </h2>
          <span class="count">{gamejams.length} projects</span>
        </div>
        <ProjectCarousel items={gamejams} id="carousel-gamejams" />
      </section>

      <CertificatesSection />
    </main>

    <footer class="site-footer container">
      <span>© {new Date().getFullYear()} Tiago "TJ" Jonathan · <a href="mailto:tiago.jonathan@pucpr.br">tiago.jonathan@pucpr.br</a></span>
    </footer>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import Lenis from "lenis";
      import { initCarousels } from "../scripts/carousel";
      import { initFloaters, initWaveDividers, initTilt, initMagneticButton, initGlitch } from "../scripts/life";

      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis({ duration: 1.1 });
      lenis.on("scroll", ScrollTrigger.update);
      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);

      initCarousels();
      initFloaters();
      initWaveDividers();
      initTilt();
      initMagneticButton();
      initGlitch();

      // Language toggle
      const langButtons = document.querySelectorAll<HTMLButtonElement>("[data-lang-btn]");
      langButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const lang = btn.dataset.langBtn as "pt" | "en";
          document.documentElement.dataset.lang = lang;
          document.documentElement.lang = lang;
          langButtons.forEach((b) =>
            b.setAttribute("aria-pressed", String(b === btn))
          );
        });
      });

      // Hero entrance animation
      gsap.from(".hero-eyebrow", { opacity: 0, y: 16, duration: 0.7, ease: "power3.out", delay: 0.1 });
      gsap.from(".hero h1", { opacity: 0, y: 24, duration: 0.9, ease: "power3.out", delay: 0.25 });
      gsap.from(".hero .bio.lang-pt, .hero .bio.lang-en", {
        opacity: 0,
        y: 20,
        duration: 0.9,
        ease: "power3.out",
        delay: 0.45,
      });
      gsap.from(".hero-actions", { opacity: 0, y: 20, duration: 0.9, ease: "power3.out", delay: 0.6 });
      gsap.from(".hero-scroll-hint", { opacity: 0, duration: 1, delay: 1 });

      // "View Portfolio" -> smooth scroll with a small flourish
      const viewBtn = document.getElementById("view-portfolio");
      viewBtn?.addEventListener("click", () => {
        gsap.to(viewBtn, {
          scale: 0.94,
          duration: 0.15,
          yoyo: true,
          repeat: 1,
          ease: "power1.inOut",
        });
        const target = document.getElementById("projects");
        if (target) {
          // @ts-expect-error lenis types
          lenis.scrollTo(target, { duration: 1.4, easing: (t: number) => 1 - Math.pow(1 - t, 3) });
        }
      });

      // Scroll-reveal for carousels (whole section, not individual scaled slides)
      gsap.utils.toArray<HTMLElement>(".embla").forEach((embla) => {
        gsap.from(embla, {
          opacity: 0,
          y: 32,
          duration: 0.8,
          ease: "power3.out",
          scrollTrigger: {
            trigger: embla,
            start: "top 88%",
          },
        });
      });
    </script>
  </body>
</html>
