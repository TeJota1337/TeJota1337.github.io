---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const num = String(index + 1).padStart(2, "0");
const linkLabel = project.category === "gamejam" ? "Play" : "Watch";
const linkLabelPt = project.category === "gamejam" ? "Jogar" : "Ver";
---

<article class="chamber reveal-chamber">
  <div class="container chamber-inner">
    <div class="chamber-plate">
      <span class="chamber-number">{num}</span>
      {project.featured && (
        <span class="chamber-badge">
          <span class="lang-pt">Destaque</span><span class="lang-en">Featured</span>
        </span>
      )}
      <p class="chamber-meta">
        {project.client}{project.date ? ` · ${project.date}` : ""}
      </p>
      {project.role && <p class="chamber-meta">{project.role}</p>}
    </div>
    <div class="chamber-body">
      <h3>{project.title}</h3>
      <p class="desc lang-pt">{project.descriptionPt}</p>
      <p class="desc lang-en">{project.descriptionEn}</p>
      {project.url && (
        <a class="link" href={project.url} target="_blank" rel="noopener noreferrer">
          <span class="lang-pt">{linkLabelPt}</span>
          <span class="lang-en">{linkLabel}</span>
        </a>
      )}
    </div>
  </div>
</article>
