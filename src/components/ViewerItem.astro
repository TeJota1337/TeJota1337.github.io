---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index: number;
  category: "education" | "gamejam";
}

const { project, index, category } = Astro.props;
const num = String(index + 1).padStart(2, "0");
const linkLabel = project.category === "gamejam" ? "Play" : "Watch";
const linkLabelPt = project.category === "gamejam" ? "Jogar" : "Ver";
---

<article class="viewer-item" data-cat={category} data-index={index}>
  <span class="viewer-item-number">{num}</span>
  {project.featured && (
    <span class="viewer-item-badge">
      <span class="lang-pt">Destaque</span><span class="lang-en">Featured</span>
    </span>
  )}
  <h3 class="glitch-target">{project.title}</h3>
  <p class="viewer-item-meta">
    {project.client}{project.date ? ` · ${project.date}` : ""}
    {project.role ? ` · ${project.role}` : ""}
  </p>
  <p class="desc lang-pt">{project.descriptionPt}</p>
  <p class="desc lang-en">{project.descriptionEn}</p>
  {project.url && (
    <a class="link" href={project.url} target="_blank" rel="noopener noreferrer">
      <span class="lang-pt">{linkLabelPt}</span>
      <span class="lang-en">{linkLabel}</span>
    </a>
  )}
</article>
