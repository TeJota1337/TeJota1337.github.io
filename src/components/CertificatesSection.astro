---
import { certificates } from "../data/certificates";
---

<section class="section container" id="certificates">
  <div class="section-heading">
    <h2>
      <span class="lang-pt">Certificados</span>
      <span class="lang-en">Certificates</span>
    </h2>
    <span class="count">{certificates.length} certificates</span>
  </div>
  <div class="cert-grid">
    {certificates.map((cert) => (
      <a
        class="cert-card"
        href={cert.verifyUrl || cert.image}
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="cert-thumb">
          <img src={cert.image} alt={cert.title} loading="lazy" />
        </div>
        <div class="cert-info">
          <h3>{cert.title}</h3>
          <p class="meta">{cert.issuer} · {cert.date}</p>
          {cert.verifyUrl && <span class="link">Verify →</span>}
        </div>
      </a>
    ))}
  </div>
</section>
